import GenLimit.Paper12_NoiseLossAndFeedback.Repetitions
import Mathlib.Data.Set.Finite.Basic
import Mathlib.Data.Set.Card

/-!
# Noise, Loss, and Feedback: deterministic finite feedback

Source: Bai--Panigrahi--Zhang, *Language Generation in the Limit:
Noise, Loss, and Feedback*, arXiv:2507.15319v2, Section 6,
Definitions 6.5--6.6 and Theorem 6.7.

At paper time `t`, a feedback generator first receives observations
`x₀, ..., xₜ` and the earlier responses `a₀, ..., aₜ₋₁`, then chooses an
optional query.  After receiving `aₜ`, it emits its ordinary generation
output.  `Option α` represents a query or `⊥`, and `Option Bool` represents
`Yes`, `No`, or `⊥`.

The source proves that finitely many membership queries do not increase
generation-in-the-limit power by a decision-tree argument.  Its printed
left/right branch convention is inconsistent.  The proof below avoids that
defect: along the actual feedback execution there are only finitely many
queries, so one may wait until every positively answered query has appeared
in the target enumeration.  From that point onward, Algorithm 5's restarted
finite-prefix simulation reproduces the actual response transcript by
induction.

This is a semantic theorem.  The construction is causal, but no
machine-level decidability, computability, or runtime claim is made.
-/

namespace GenLimit.NoiseLossFeedback

open GenLimit.Generic

variable {α : Type*}

/-- A deterministic feedback generator in the paper's alternating
query/response convention. -/
structure FeedbackGenerator (α : Type*) where
  query :
    (t : ℕ) →
      (Fin (t + 1) → α) →
      (Fin t → Option Bool) →
      Option α
  output :
    (t : ℕ) →
      (Fin (t + 1) → α) →
      (Fin (t + 1) → Option Bool) →
      α

/-- Regard an ordinary generator as a feedback generator that never asks a
query and ignores the response transcript. -/
def withoutFeedbackAsFeedback
    (gen : Generator α) : FeedbackGenerator α where
  query := fun _t _observations _responses => none
  output := fun t observations _responses =>
    gen (t + 1) observations

/-- The query made at time `t` against a complete observation and response
stream.  Only the causal prefixes required by the generator are supplied. -/
def feedbackQuery
    (gen : FeedbackGenerator α)
    (stream : Stream α)
    (responses : ℕ → Option Bool)
    (t : ℕ) : Option α :=
  gen.query t
    (fun i => stream i)
    (fun i => responses i)

@[simp] theorem feedbackQuery_withoutFeedbackAsFeedback
    (gen : Generator α) (stream : Stream α)
    (responses : ℕ → Option Bool) (t : ℕ) :
    feedbackQuery (withoutFeedbackAsFeedback gen)
      stream responses t = none := rfl

/-- A response stream respects the query/`⊥` pattern chosen by the
generator.  At queried positions either Boolean answer is permitted. -/
def CompatibleResponses
    (gen : FeedbackGenerator α)
    (stream : Stream α)
    (responses : ℕ → Option Bool) : Prop :=
  ∀ t,
    (feedbackQuery gen stream responses t).isSome =
      (responses t).isSome

/-- Definition 6.5's query-budget condition.  It is stated on every valid
alternating execution, independently of the target language. -/
def HasAtMostQueries
    (gen : FeedbackGenerator α) (budget : ℕ) : Prop :=
  ∀ stream responses,
    CompatibleResponses gen stream responses →
      {t | (feedbackQuery gen stream responses t).isSome}.Finite ∧
      {t | (feedbackQuery gen stream responses t).isSome}.ncard ≤
        budget

theorem withoutFeedbackAsFeedback_hasAtMostQueries
    (gen : Generator α) (budget : ℕ) :
    HasAtMostQueries (withoutFeedbackAsFeedback gen) budget := by
  intro stream responses _hcompatible
  simp

/-- Boolean membership answer, isolated as a noncomputable semantic oracle. -/
noncomputable def membershipAnswer
    (L : GenLimit.Generic.Language α) (query : α) : Bool := by
  classical
  exact decide (query ∈ L)

/-- The target-membership response stream generated by the real feedback
execution. -/
noncomputable def actualFeedbackResponse
    (gen : FeedbackGenerator α)
    (L : GenLimit.Generic.Language α) (stream : Stream α)
    (t : ℕ) : Option Bool :=
  match
      gen.query t
        (fun i => stream i)
        (fun i => actualFeedbackResponse gen L stream i) with
  | none => none
  | some query =>
      some (membershipAnswer L query)
termination_by t
decreasing_by
  exact i.isLt

theorem actualFeedbackResponse_eq
    (gen : FeedbackGenerator α)
    (L : GenLimit.Generic.Language α) (stream : Stream α)
    (t : ℕ) :
    actualFeedbackResponse gen L stream t =
      match
          gen.query t
            (fun i => stream i)
            (fun i => actualFeedbackResponse gen L stream i) with
      | none => none
      | some query =>
          some (membershipAnswer L query) := by
  rw [actualFeedbackResponse]

theorem actualFeedbackResponse_compatible
    (gen : FeedbackGenerator α)
    (L : GenLimit.Generic.Language α) (stream : Stream α) :
    CompatibleResponses gen stream
      (actualFeedbackResponse gen L stream) := by
  intro t
  unfold feedbackQuery
  rw [actualFeedbackResponse_eq]
  split <;> simp_all

/-- The actual output after the target has answered the time-`t` query. -/
noncomputable def actualFeedbackOutput
    (gen : FeedbackGenerator α)
    (L : GenLimit.Generic.Language α) (stream : Stream α)
    (t : ℕ) : α :=
  gen.output t
    (fun i => stream i)
    (fun i => actualFeedbackResponse gen L stream i)

@[simp] theorem actualFeedbackOutput_withoutFeedbackAsFeedback
    (gen : Generator α)
    (L : GenLimit.Generic.Language α) (stream : Stream α)
    (t : ℕ) :
    actualFeedbackOutput (withoutFeedbackAsFeedback gen) L stream t =
      outputAt gen stream t := rfl

/-- Correctness in the feedback model at the paper's inclusive time `t`. -/
def FeedbackCorrectAt
    (gen : FeedbackGenerator α)
    (L : GenLimit.Generic.Language α) (stream : Stream α)
    (t : ℕ) : Prop :=
  actualFeedbackOutput gen L stream t ∈ L ∧
    actualFeedbackOutput gen L stream t ∉
      observedThrough stream t

/-- Definition 6.6 at a fixed generator and finite query budget. -/
def IsLimitFeedbackGeneratorWithQueries
    (gen : FeedbackGenerator α)
    (C : GenLimit.Generic.LanguageClass α) (budget : ℕ) : Prop :=
  HasAtMostQueries gen budget ∧
    ∀ L, L ∈ C → ∀ stream,
      ExactEnumeration stream L →
        ∃ T, ∀ t, T ≤ t →
          FeedbackCorrectAt gen L stream t

/-- Existential generation in the limit with at most `budget` feedback
queries. -/
def GeneratableInLimitWithQueries
    (C : GenLimit.Generic.LanguageClass α) (budget : ℕ) : Prop :=
  ∃ gen : FeedbackGenerator α,
    IsLimitFeedbackGeneratorWithQueries gen C budget

/-! ## Algorithm 5: restarted finite-prefix simulation -/

/-- Restrict a length-`n` observation history to its first `j+1` entries. -/
def observationPrefix
    {n : ℕ} (observations : Fin n → α)
    (j : ℕ) (hj : j < n) :
    Fin (j + 1) → α :=
  fun k =>
    observations
      ⟨k, Nat.lt_of_le_of_lt
        (Nat.le_of_lt_succ k.isLt) hj⟩

/-- Membership answer in a finite observation sample. -/
noncomputable def finiteSampleAnswer
    {n : ℕ} (observations : Fin n → α)
    (query : α) : Bool := by
  classical
  exact decide
    (query ∈ GenLimit.Generic.sequenceSample observations)

/-- Algorithm 5's simulated response at position `j`.  Every query is
answered using membership in the entire currently observed finite sample,
while the query itself sees only the causal prefix through `j`. -/
noncomputable def simulatedFeedbackResponse
    (gen : FeedbackGenerator α)
    {n : ℕ} (observations : Fin n → α)
    (j : ℕ) (hj : j < n) : Option Bool :=
  match
      gen.query j
        (observationPrefix observations j hj)
        (fun k =>
          simulatedFeedbackResponse gen observations k
            (lt_trans k.isLt hj)) with
  | none => none
  | some query =>
      some (finiteSampleAnswer observations query)
termination_by j
decreasing_by
  exact k.isLt

theorem simulatedFeedbackResponse_eq
    (gen : FeedbackGenerator α)
    {n : ℕ} (observations : Fin n → α)
    (j : ℕ) (hj : j < n) :
    simulatedFeedbackResponse gen observations j hj =
      match
          gen.query j
            (observationPrefix observations j hj)
            (fun k =>
              simulatedFeedbackResponse gen observations k
                (lt_trans k.isLt hj)) with
      | none => none
      | some query =>
          some (finiteSampleAnswer observations query) := by
  rw [simulatedFeedbackResponse]

/-- Algorithm 5's simulated output on a nonempty finite observation
history. -/
noncomputable def simulatedFeedbackOutput
    (gen : FeedbackGenerator α)
    {n : ℕ} (observations : Fin n → α)
    (hn : 0 < n) : α :=
  let t := n - 1
  gen.output t
    (observationPrefix observations t
      (by omega))
    (fun j =>
      simulatedFeedbackResponse gen observations j
        (by omega))

/-- Algorithm 5 as an ordinary prefix generator.  Its value on the empty
history is irrelevant to the paper's inclusive-time semantics. -/
noncomputable def removeFiniteFeedback
    [Nonempty α]
    (gen : FeedbackGenerator α) : Generator α :=
  fun n observations =>
    if hn : 0 < n then
      simulatedFeedbackOutput gen observations hn
    else
      Classical.choice ‹Nonempty α›

/-! ## Finiteness of the actual query set -/

/-- Values queried along the actual target-membership execution. -/
def actualQueryValueSet
    (gen : FeedbackGenerator α)
    (L : GenLimit.Generic.Language α)
    (stream : Stream α) : Set α :=
  {query |
    ∃ t,
      feedbackQuery gen stream
          (actualFeedbackResponse gen L stream) t =
        some query}

theorem actualQueryValueSet_finite
    {gen : FeedbackGenerator α} {budget : ℕ}
    (hbudget : HasAtMostQueries gen budget)
    (L : GenLimit.Generic.Language α)
    (stream : Stream α) :
    (actualQueryValueSet gen L stream).Finite := by
  let responses := actualFeedbackResponse gen L stream
  let queryAt :=
    feedbackQuery gen stream responses
  obtain ⟨hfinite, _hcard⟩ :=
    hbudget stream responses
      (actualFeedbackResponse_compatible gen L stream)
  let fallback := stream 0
  have himage :
      ((fun t => (queryAt t).getD fallback) ''
        {t | (queryAt t).isSome}).Finite :=
    hfinite.image _
  apply himage.subset
  intro query hquery
  obtain ⟨t, ht⟩ := hquery
  have htSome : (queryAt t).isSome := by
    change
      (feedbackQuery gen stream
        (actualFeedbackResponse gen L stream) t).isSome
    rw [ht]
    rfl
  refine ⟨t, htSome, ?_⟩
  change
    (feedbackQuery gen stream
      (actualFeedbackResponse gen L stream) t).getD
        (stream 0) =
      query
  rw [ht]
  rfl

/-- Since the actual execution asks only finitely many queries, every one
whose correct answer is `Yes` has appeared by one finite presentation time. -/
theorem exists_positive_actual_queries_seen
    {gen : FeedbackGenerator α} {budget : ℕ}
    (hbudget : HasAtMostQueries gen budget)
    {L : GenLimit.Generic.Language α}
    {stream : Stream α}
    (hpresents : GenLimit.Generic.Presents stream L) :
    ∃ T,
      ∀ query,
        query ∈ actualQueryValueSet gen L stream →
        query ∈ L →
        query ∈ GenLimit.Generic.sample stream T := by
  have hqueries :
      (actualQueryValueSet gen L stream).Finite :=
    actualQueryValueSet_finite hbudget L stream
  let positiveQueries : Set α :=
    actualQueryValueSet gen L stream ∩ L
  have hpositive : positiveQueries.Finite :=
    hqueries.inter_of_left L
  let required : Finset α := hpositive.toFinset
  have hrequiredTarget :
      (required : Set α) ⊆ L := by
    intro query hquery
    have hpositiveQuery : query ∈ positiveQueries := by
      simpa [required] using hquery
    exact hpositiveQuery.2
  obtain ⟨T, hT⟩ :=
    GenLimit.Generic.finset_eventually_subset_sample
      hpresents required hrequiredTarget
  refine ⟨T, ?_⟩
  intro query hqueryValue hqueryTarget
  apply hT
  simp [required, positiveQueries, hqueryValue, hqueryTarget]

theorem membershipAnswer_eq_finiteSampleAnswer
    {L : GenLimit.Generic.Language α}
    {n : ℕ} {observations : Fin n → α}
    {query : α}
    (hiff :
      query ∈ L ↔
        query ∈
          GenLimit.Generic.sequenceSample observations) :
    membershipAnswer L query =
      finiteSampleAnswer observations query := by
  classical
  by_cases htarget : query ∈ L
  · have hsample := hiff.mp htarget
    simp [membershipAnswer, finiteSampleAnswer,
      htarget, hsample]
  · have hsample : query ∉
        GenLimit.Generic.sequenceSample observations :=
      fun hmem => htarget (hiff.mpr hmem)
    simp [membershipAnswer, finiteSampleAnswer,
      htarget, hsample]

/-- Once all positively answered actual queries have been observed, the
restarted simulation agrees with the actual response at every position of
the current prefix. -/
theorem simulatedFeedbackResponse_eq_actual
    (gen : FeedbackGenerator α)
    (L : GenLimit.Generic.Language α)
    (stream : Stream α)
    (horizon : ℕ)
    (hstreamIn :
      GenLimit.Generic.StreamIn stream L)
    (hpositiveSeen :
      ∀ query,
        query ∈ actualQueryValueSet gen L stream →
        query ∈ L →
        query ∈ GenLimit.Generic.sample stream (horizon + 1))
    (j : ℕ) (hj : j < horizon + 1) :
    simulatedFeedbackResponse gen
        (fun i : Fin (horizon + 1) => stream i) j hj =
      actualFeedbackResponse gen L stream j := by
  induction j using Nat.strong_induction_on with
  | h j ih =>
      rw [simulatedFeedbackResponse_eq,
        actualFeedbackResponse_eq]
      have hquery :
          gen.query j
              (observationPrefix
                (fun i : Fin (horizon + 1) => stream i)
                j hj)
              (fun k =>
                simulatedFeedbackResponse gen
                  (fun i : Fin (horizon + 1) => stream i)
                  k (lt_trans k.isLt hj)) =
            gen.query j
              (fun i => stream i)
              (fun i =>
                actualFeedbackResponse gen L stream i) := by
        congr 1
        funext k
        exact ih k k.isLt (lt_trans k.isLt hj)
      rw [hquery]
      cases hqueryAt :
          gen.query j
            (fun i => stream i)
            (fun i =>
              actualFeedbackResponse gen L stream i) with
      | none => rfl
      | some query =>
          simp only
          congr 1
          symm
          apply membershipAnswer_eq_finiteSampleAnswer
            (observations :=
              fun i : Fin (horizon + 1) => stream i)
          constructor
          · intro hqueryTarget
            rw [GenLimit.Generic.sequenceSample_prefix]
            apply hpositiveSeen query
            · exact ⟨j, by
                simpa [feedbackQuery] using hqueryAt⟩
            · exact hqueryTarget
          · intro hquerySample
            rw [GenLimit.Generic.sequenceSample_prefix] at hquerySample
            rw [GenLimit.Generic.mem_sample_iff] at hquerySample
            obtain ⟨time, _htime, hvalue⟩ := hquerySample
            exact hstreamIn ⟨time, hvalue⟩

/-- Response agreement at every coordinate makes Algorithm 5's restarted
output coincide with the output of the actual feedback execution. -/
theorem simulatedFeedbackOutput_eq_actual
    (gen : FeedbackGenerator α)
    (L : GenLimit.Generic.Language α)
    (stream : Stream α)
    (horizon : ℕ)
    (hstreamIn :
      GenLimit.Generic.StreamIn stream L)
    (hpositiveSeen :
      ∀ query,
        query ∈ actualQueryValueSet gen L stream →
        query ∈ L →
        query ∈ GenLimit.Generic.sample stream (horizon + 1)) :
    simulatedFeedbackOutput gen
        (fun i : Fin (horizon + 1) => stream i)
        (Nat.zero_lt_succ horizon) =
      actualFeedbackOutput gen L stream horizon := by
  change
    gen.output horizon
        (fun i => stream i)
        (fun j =>
          simulatedFeedbackResponse gen
            (fun i : Fin (horizon + 1) => stream i)
            j (by omega)) =
      gen.output horizon
        (fun i => stream i)
        (fun j =>
          actualFeedbackResponse gen L stream j)
  congr 1
  funext j
  exact
    simulatedFeedbackResponse_eq_actual
      gen L stream horizon hstreamIn hpositiveSeen
      j j.isLt

theorem removeFiniteFeedback_outputAt
    [Nonempty α]
    (gen : FeedbackGenerator α)
    (stream : Stream α) (t : ℕ) :
    outputAt (removeFiniteFeedback gen) stream t =
      simulatedFeedbackOutput gen
        (fun i : Fin (t + 1) => stream i)
        (Nat.zero_lt_succ t) := by
  simp [outputAt, GenLimit.Generic.output,
    removeFiniteFeedback]

/-- After one finite burn-in, Algorithm 5 reproduces the actual feedback
output at every later paper time. -/
theorem removeFiniteFeedback_eventually_matches
    [Nonempty α]
    {gen : FeedbackGenerator α} {budget : ℕ}
    (hbudget : HasAtMostQueries gen budget)
    {L : GenLimit.Generic.Language α}
    {stream : Stream α}
    (hpresents : GenLimit.Generic.Presents stream L) :
    ∃ T, ∀ t, T ≤ t →
      outputAt (removeFiniteFeedback gen) stream t =
        actualFeedbackOutput gen L stream t := by
  obtain ⟨T, hT⟩ :=
    exists_positive_actual_queries_seen
      hbudget hpresents
  refine ⟨T, ?_⟩
  intro t ht
  rw [removeFiniteFeedback_outputAt]
  apply simulatedFeedbackOutput_eq_actual
  · exact
      GenLimit.Generic.streamIn_of_presents hpresents
  · intro query hqueryValue hqueryTarget
    apply GenLimit.Generic.sample_mono
      (show T ≤ t + 1 by omega)
    exact hT query hqueryValue hqueryTarget

theorem correctAt_of_feedbackCorrectAt_of_outputs_eq
    [Nonempty α]
    {gen : FeedbackGenerator α}
    {L : GenLimit.Generic.Language α}
    {stream : Stream α} {t : ℕ}
    (houtput :
      outputAt (removeFiniteFeedback gen) stream t =
        actualFeedbackOutput gen L stream t)
    (hcorrect :
      FeedbackCorrectAt gen L stream t) :
    CorrectAt (removeFiniteFeedback gen) L stream t := by
  unfold CorrectAt FeedbackCorrectAt at *
  rw [houtput]
  exact hcorrect

/-- Generic deterministic finite-feedback elimination. -/
theorem finiteFeedback_to_noFeedback
    [Nonempty α]
    {C : GenLimit.Generic.LanguageClass α}
    {budget : ℕ}
    (hfeedback :
      GeneratableInLimitWithQueries C budget) :
    GeneratableInLimitWithoutRepetitions C := by
  obtain ⟨gen, hbudget, hsuccess⟩ := hfeedback
  refine ⟨removeFiniteFeedback gen, ?_⟩
  intro L hL stream henumeration
  obtain ⟨feedbackThreshold, hfeedbackCorrect⟩ :=
    hsuccess L hL stream henumeration
  obtain ⟨simulationThreshold, hsimulation⟩ :=
    removeFiniteFeedback_eventually_matches
      hbudget henumeration.2
  refine
    ⟨max feedbackThreshold simulationThreshold, ?_⟩
  intro t ht
  apply correctAt_of_feedbackCorrectAt_of_outputs_eq
  · exact hsimulation t
      ((Nat.le_max_right _ _).trans ht)
  · exact hfeedbackCorrect t
      ((Nat.le_max_left _ _).trans ht)

/-- Ordinary no-feedback generation embeds into every finite feedback
budget by making no queries. -/
theorem noFeedback_to_finiteFeedback
    {C : GenLimit.Generic.LanguageClass α}
    {budget : ℕ}
    (hnoFeedback :
      GeneratableInLimitWithoutRepetitions C) :
    GeneratableInLimitWithQueries C budget := by
  obtain ⟨gen, hgen⟩ := hnoFeedback
  refine
    ⟨withoutFeedbackAsFeedback gen,
      withoutFeedbackAsFeedback_hasAtMostQueries gen budget, ?_⟩
  intro L hL stream henumeration
  obtain ⟨T, hT⟩ := hgen L hL stream henumeration
  refine ⟨T, ?_⟩
  intro t ht
  simpa only
      [FeedbackCorrectAt,
        actualFeedbackOutput_withoutFeedbackAsFeedback,
        CorrectAt] using hT t ht

/-- A fixed finite feedback budget has exactly the power of ordinary
generation in the repetition-free presentation model. -/
theorem finiteFeedback_iff_noFeedback
    [Nonempty α]
    (C : GenLimit.Generic.LanguageClass α)
    (budget : ℕ) :
    GeneratableInLimitWithQueries C budget ↔
      GeneratableInLimitWithoutRepetitions C :=
  ⟨finiteFeedback_to_noFeedback,
    noFeedback_to_finiteFeedback⟩

/-- Theorem 6.7: over the paper's universe `ℕ`, a fixed finite number of
membership queries does not enlarge generation-in-the-limit power. -/
theorem theorem_6_7
    (C : GenLimit.Generic.LanguageClass ℕ)
    (budget : ℕ) :
    GeneratableInLimitWithQueries C budget →
      GeneratableInLimitWithoutRepetitions C :=
  finiteFeedback_to_noFeedback

end GenLimit.NoiseLossFeedback
