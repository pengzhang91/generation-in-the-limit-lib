import GenLimit.Paper27_FeedbackQueriesAndMistakes.QueryFeedback
import Mathlib.Order.Interval.Finset.Nat

/-!
# Element/set separation under query feedback

Theorem 3.3 separates element- and set-based query feedback by
an explicit three-point block family.  That literal witness is not yet
formalized.  This file proves a different and substantially easier semantic
separation:

* one membership query for each natural number lets an element generator
  eventually repeat a discovered target member for every infinite target;
* the class of all infinite subsets of `ℕ` has no countable inner cover, so
  the checked set-query characterization rules out set generation.

The result is useful as an auxiliary sanity check, but it is not a
formalization of source Theorem 3.3: its class, element success condition, and
batch-query interface differ from the paper's construction.
-/

namespace GenLimit.FeedbackQueries

open GenLimit.Generic

/-! ## Element generation from finite query histories -/

/-- An element-valued finite-query strategy.  Round `t` submits `t+1`
membership queries and then emits one element. -/
structure ElementQueryStrategy (α : Type*) where
  query : ∀ t, Fin (t + 1) → α
  output : ∀ t, (Fin (t + 1) → Bool) → α

noncomputable def truthfulElementAnswers
    (strategy : ElementQueryStrategy α)
    (target : Set α) (t : ℕ) :
    Fin (t + 1) → Bool :=
  fun i => membershipAnswer target (strategy.query t i)

noncomputable def elementQueryOutput
    (strategy : ElementQueryStrategy α)
    (target : Set α) (t : ℕ) : α :=
  strategy.output t (truthfulElementAnswers strategy target t)

def ElementQuerySucceedsOn
    (strategy : ElementQueryStrategy α)
    (target : Set α) : Prop :=
  ∃ T, ∀ t, T ≤ t →
    elementQueryOutput strategy target t ∈ target

def ElementQueryGenerates
    (strategy : ElementQueryStrategy α)
    (targets : LanguageClass α) : Prop :=
  ∀ L, L ∈ targets → ElementQuerySucceedsOn strategy L

def ElementQueryGeneratable
    (targets : LanguageClass α) : Prop :=
  ∃ strategy : ElementQueryStrategy α,
    ElementQueryGenerates strategy targets

/-- The least positively answered row, with a total fallback. -/
noncomputable def firstPositiveElementRow
    (t : ℕ) (answers : Fin (t + 1) → Bool) : ℕ := by
  classical
  exact if h :
      ∃ i : ℕ, ∃ hi : i < t + 1,
        answers ⟨i, hi⟩ = true
    then Nat.find h
    else 0

theorem firstPositiveElementRow_spec
    {t : ℕ} {answers : Fin (t + 1) → Bool}
    (hexists :
      ∃ i : ℕ, ∃ hi : i < t + 1,
        answers ⟨i, hi⟩ = true) :
    ∃ hi : firstPositiveElementRow t answers < t + 1,
      answers ⟨firstPositiveElementRow t answers, hi⟩ = true := by
  classical
  simp only [firstPositiveElementRow, dif_pos hexists]
  exact Nat.find_spec hexists

/-- Query the initial segment `0,...,t` and emit its least positive row. -/
noncomputable def initialSegmentElementQueryStrategy :
    ElementQueryStrategy ℕ where
  query := fun _t i => i
  output := fun t answers => firstPositiveElementRow t answers

/-- Every nonempty natural-number language is eventually generated by the
initial-segment membership-query strategy. -/
theorem initialSegmentElementQuery_generates_nonempty
    (L : Set ℕ) (hL : L.Nonempty) :
    ElementQuerySucceedsOn initialSegmentElementQueryStrategy L := by
  classical
  obtain ⟨x, hxL⟩ := hL
  refine ⟨x, ?_⟩
  intro t hxt
  have hxlt : x < t + 1 := Nat.lt_succ_iff.mpr hxt
  let answers :=
    truthfulElementAnswers initialSegmentElementQueryStrategy L t
  have hxanswer : answers ⟨x, hxlt⟩ = true := by
    exact (membershipAnswer_eq_true_iff L x).mpr hxL
  have hexists :
      ∃ i : ℕ, ∃ hi : i < t + 1,
        answers ⟨i, hi⟩ = true :=
    ⟨x, hxlt, hxanswer⟩
  obtain ⟨hselected, hanswer⟩ :=
    firstPositiveElementRow_spec hexists
  change firstPositiveElementRow t answers ∈ L
  exact (membershipAnswer_eq_true_iff L
    (firstPositiveElementRow t answers)).mp hanswer

/-- The class of every infinite subset of `ℕ`. -/
def allInfiniteNatLanguages : LanguageClass ℕ :=
  {L | L.Infinite}

theorem allInfiniteNatLanguages_elementQueryGeneratable :
    ElementQueryGeneratable allInfiniteNatLanguages := by
  refine ⟨initialSegmentElementQueryStrategy, ?_⟩
  intro L hL
  exact initialSegmentElementQuery_generates_nonempty L hL.nonempty

/-! ## A sparse diagonal against every proposed countable inner cover -/

/-- Recursively remove one point from cover `n`, leaving a one-point gap
after every preceding removed point. -/
noncomputable def diagonalRemoved
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite) : ℕ → ℕ
  | 0 =>
      Classical.choose ((hinfinite 0).exists_gt 0)
  | n + 1 =>
      Classical.choose
        ((hinfinite (n + 1)).exists_gt
          (diagonalRemoved cover hinfinite n + 1))

theorem diagonalRemoved_mem
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite)
    (n : ℕ) :
    diagonalRemoved cover hinfinite n ∈ cover n := by
  cases n with
  | zero =>
      exact (Classical.choose_spec
        ((hinfinite 0).exists_gt 0)).1
  | succ n =>
      exact (Classical.choose_spec
        ((hinfinite (n + 1)).exists_gt
          (diagonalRemoved cover hinfinite n + 1))).1

theorem diagonalRemoved_gap
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite)
    (n : ℕ) :
    diagonalRemoved cover hinfinite n + 1 <
      diagonalRemoved cover hinfinite (n + 1) := by
  exact (Classical.choose_spec
    ((hinfinite (n + 1)).exists_gt
      (diagonalRemoved cover hinfinite n + 1))).2

theorem diagonalRemoved_strictMono
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite) :
    StrictMono (diagonalRemoved cover hinfinite) :=
  strictMono_nat_of_lt_succ fun n =>
    lt_of_lt_of_le
      (Nat.lt_succ_self (diagonalRemoved cover hinfinite n))
      (Nat.le_of_lt (diagonalRemoved_gap cover hinfinite n))

/-- The points immediately following the sparse removed sequence. -/
noncomputable def diagonalKept
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite)
    (n : ℕ) : ℕ :=
  diagonalRemoved cover hinfinite n + 1

theorem diagonalKept_injective
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite) :
    Function.Injective (diagonalKept cover hinfinite) := by
  intro m n hmn
  unfold diagonalKept at hmn
  exact (diagonalRemoved_strictMono cover hinfinite).injective
    (Nat.add_right_cancel hmn)

theorem diagonalKept_ne_removed
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite)
    (n m : ℕ) :
    diagonalKept cover hinfinite n ≠
      diagonalRemoved cover hinfinite m := by
  intro heq
  have hmono :=
    (diagonalRemoved_strictMono cover hinfinite).monotone
  by_cases hmn : m ≤ n
  · have hle :
        diagonalRemoved cover hinfinite m ≤
          diagonalRemoved cover hinfinite n :=
      hmono hmn
    unfold diagonalKept at heq
    omega
  · have hnm : n + 1 ≤ m :=
      Nat.succ_le_iff.mpr (Nat.lt_of_not_ge hmn)
    have hle :
        diagonalRemoved cover hinfinite (n + 1) ≤
          diagonalRemoved cover hinfinite m :=
      hmono hnm
    have hgap := diagonalRemoved_gap cover hinfinite n
    unfold diagonalKept at heq
    omega

/-- The infinite diagonal target retained between removed cover witnesses. -/
def diagonalTarget
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite) : Set ℕ :=
  Set.range (diagonalKept cover hinfinite)

theorem diagonalTarget_infinite
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite) :
    (diagonalTarget cover hinfinite).Infinite :=
  Set.infinite_range_of_injective
    (diagonalKept_injective cover hinfinite)

theorem diagonalRemoved_not_mem_target
    (cover : ℕ → Set ℕ)
    (hinfinite : ∀ i, (cover i).Infinite)
    (i : ℕ) :
    diagonalRemoved cover hinfinite i ∉
      diagonalTarget cover hinfinite := by
  rintro ⟨n, hn⟩
  exact diagonalKept_ne_removed cover hinfinite n i hn

theorem no_countableInnerCover_allInfiniteNatLanguages :
    ¬ HasCountableInnerCover allInfiniteNatLanguages := by
  rintro ⟨inner⟩
  let target :=
    diagonalTarget inner.cover inner.infinite_cover
  have htargetInfinite : target.Infinite :=
    diagonalTarget_infinite inner.cover inner.infinite_cover
  obtain ⟨i, hi⟩ :=
    inner.contained target htargetInfinite
  exact
    diagonalRemoved_not_mem_target
      inner.cover inner.infinite_cover i
      (hi (diagonalRemoved_mem
        inner.cover inner.infinite_cover i))

theorem allInfiniteNatLanguages_not_setQueryGeneratable :
    ¬ SetQueryGeneratable allInfiniteNatLanguages := by
  intro hquery
  exact no_countableInnerCover_allInfiniteNatLanguages
    (setQuery_implies_countableInnerCover hquery)

/-- The auxiliary batch-query separation for the class of all infinite
subsets of `ℕ`.  This name records the theorem actually proved and should be
preferred in new code. -/
theorem allInfiniteNatLanguages_batchQuery_separation_extra :
    ElementQueryGeneratable allInfiniteNatLanguages ∧
      ¬ SetQueryGeneratable allInfiniteNatLanguages :=
  ⟨allInfiniteNatLanguages_elementQueryGeneratable,
    allInfiniteNatLanguages_not_setQueryGeneratable⟩

/-- Compatibility alias for the historical name.  Despite that name, this is
the auxiliary all-infinite-language separation above, not source Theorem 3.3. -/
theorem theorem_3_3_querySeparation_core :
    ElementQueryGeneratable allInfiniteNatLanguages ∧
      ¬ SetQueryGeneratable allInfiniteNatLanguages :=
  allInfiniteNatLanguages_batchQuery_separation_extra

end GenLimit.FeedbackQueries
