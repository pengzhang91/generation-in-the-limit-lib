import GenLimit.Core.Basic
import GenLimit.Support.Presentations
import Mathlib.Data.Set.Finite.Basic
import Mathlib.Topology.Defs.Basic

/-!
# Infinite perfect towers and the Kleinberg--Wei topology

Shared infrastructure for #07 Density Measures and #23 Banach Density. For a
collection X of languages, the basic neighborhood of K fixes a finite subset
of K and restricts to sublanguages of K.
-/

namespace GenLimit.KleinbergWei.TowerTopology

/-- Languages in X, viewed as points of the topology. -/
abbrev Point (X : Set Language) := {L : Language // L ∈ X}

/-- The basis set U(K,F). -/
def basicNeighborhood
    (X : Set Language) (K : Point X) (F : Finset ℕ) : Set (Point X) :=
  {L | (↑F : Set ℕ) ⊆ L.1 ∧ L.1 ⊆ K.1}

@[simp] theorem mem_basicNeighborhood
    {X : Set Language} {K L : Point X} {F : Finset ℕ} :
    L ∈ basicNeighborhood X K F ↔
      (↑F : Set ℕ) ⊆ L.1 ∧ L.1 ⊆ K.1 :=
  Iff.rfl

/-- Local-basis presentation of the open sets. -/
def KWOpen (X : Set Language) (O : Set (Point X)) : Prop :=
  ∀ K, K ∈ O →
    ∃ F : Finset ℕ,
      (↑F : Set ℕ) ⊆ K.1 ∧ basicNeighborhood X K F ⊆ O

theorem kwOpen_univ (X : Set Language) : KWOpen X Set.univ := by
  intro K _
  exact ⟨∅, by simp, by simp⟩

theorem kwOpen_inter
    {X : Set Language} {U V : Set (Point X)}
    (hU : KWOpen X U) (hV : KWOpen X V) :
    KWOpen X (U ∩ V) := by
  intro K hK
  obtain ⟨F, hFK, hFU⟩ := hU K hK.1
  obtain ⟨G, hGK, hGV⟩ := hV K hK.2
  refine ⟨F ∪ G, ?_, ?_⟩
  · intro u hu
    simp only [Finset.mem_coe, Finset.mem_union] at hu
    exact hu.elim (fun h => hFK h) (fun h => hGK h)
  · intro L hL
    refine ⟨hFU ?_, hGV ?_⟩
    · exact ⟨fun u hu => hL.1 (by simp [hu]), hL.2⟩
    · exact ⟨fun u hu => hL.1 (by simp [hu]), hL.2⟩

theorem kwOpen_sUnion
    {X : Set Language} {S : Set (Set (Point X))}
    (hS : ∀ O ∈ S, KWOpen X O) :
    KWOpen X (⋃₀ S) := by
  intro K hK
  obtain ⟨O, hOS, hKO⟩ := Set.mem_sUnion.mp hK
  obtain ⟨F, hFK, hFO⟩ := hS O hOS K hKO
  exact ⟨F, hFK, fun L hL => Set.mem_sUnion.mpr ⟨O, hOS, hFO hL⟩⟩

/-- The topology generated by the finite-containment basis. -/
def topology (X : Set Language) : TopologicalSpace (Point X) where
  IsOpen := KWOpen X
  isOpen_univ := kwOpen_univ X
  isOpen_inter := fun _ _ => kwOpen_inter
  isOpen_sUnion := fun _ => kwOpen_sUnion

theorem basicNeighborhood_open
    (X : Set Language) (K : Point X) (F : Finset ℕ) :
    KWOpen X (basicNeighborhood X K F) := by
  intro L hL
  refine ⟨F, hL.1, ?_⟩
  intro M hM
  exact ⟨hM.1, hM.2.trans hL.2⟩

theorem self_mem_basicNeighborhood
    {X : Set Language} {K : Point X} {F : Finset ℕ}
    (hF : (↑F : Set ℕ) ⊆ K.1) :
    K ∈ basicNeighborhood X K F :=
  ⟨hF, Set.Subset.rfl⟩

/-- Basis-level non-isolation. -/
def BasisLimitPoint {X : Set Language} (K : Point X) : Prop :=
  ∀ F : Finset ℕ, (↑F : Set ℕ) ⊆ K.1 →
    ∃ L : Point X, L ≠ K ∧ L ∈ basicNeighborhood X K F

/-- Intrinsic open-set non-isolation. -/
def IsLimitPoint {X : Set Language} (K : Point X) : Prop :=
  ∀ O : Set (Point X), KWOpen X O → K ∈ O →
    ∃ L ∈ O, L ≠ K

theorem basisLimitPoint_iff_isLimitPoint
    {X : Set Language} {K : Point X} :
    BasisLimitPoint K ↔ IsLimitPoint K := by
  constructor
  · intro hBasis O hO hKO
    obtain ⟨F, hFK, hFO⟩ := hO K hKO
    obtain ⟨L, hne, hLF⟩ := hBasis F hFK
    exact ⟨L, hFO hLF, hne⟩
  · intro hLim F hFK
    obtain ⟨L, hLF, hne⟩ :=
      hLim (basicNeighborhood X K F)
        (basicNeighborhood_open X K F)
        (self_mem_basicNeighborhood hFK)
    exact ⟨L, hne, hLF⟩

/-- Hausdorff separation in the source basis. -/
def Hausdorff (X : Set Language) : Prop :=
  ∀ K L : Point X, K ≠ L →
    ∃ U V : Set (Point X),
      KWOpen X U ∧ KWOpen X V ∧
        K ∈ U ∧ L ∈ V ∧ Disjoint U V

theorem hausdorff (X : Set Language) : Hausdorff X := by
  intro K L hKL
  have hsets : K.1 ≠ L.1 := fun h => hKL (Subtype.ext h)
  have hdiff :
      (∃ u, u ∈ K.1 ∧ u ∉ L.1) ∨
        (∃ u, u ∈ L.1 ∧ u ∉ K.1) := by
    by_contra h
    push_neg at h
    exact hsets (Set.Subset.antisymm (fun u hu => h.1 u hu)
      (fun u hu => h.2 u hu))
  rcases hdiff with ⟨u, huK, huL⟩ | ⟨u, huL, huK⟩
  · let U := basicNeighborhood X K {u}
    let V := basicNeighborhood X L ∅
    refine ⟨U, V, basicNeighborhood_open X K {u},
      basicNeighborhood_open X L ∅, ?_, ?_, ?_⟩
    · exact ⟨by simpa using huK, Set.Subset.rfl⟩
    · exact ⟨by simp, Set.Subset.rfl⟩
    · rw [Set.disjoint_left]
      intro M hMU hMV
      exact huL (hMV.2 (hMU.1 (by simp)))
  · let U := basicNeighborhood X K ∅
    let V := basicNeighborhood X L {u}
    refine ⟨U, V, basicNeighborhood_open X K ∅,
      basicNeighborhood_open X L {u}, ?_, ?_, ?_⟩
    · exact ⟨by simp, Set.Subset.rfl⟩
    · exact ⟨by simpa using huL, Set.Subset.rfl⟩
    · rw [Set.disjoint_left]
      intro M hMU hMV
      exact huK (hMU.2 (hMV.1 (by simp)))

/-- Every finite subset of an exactly presented language eventually appears
in every later sample. This reuses the generic Core progress theorem. -/
theorem finite_eventually_subset_sample
    {enumeration : ℕ → ℕ} {K : Language}
    (hP : Presents enumeration K)
    (F : Finset ℕ) (hF : (↑F : Set ℕ) ⊆ K) :
    ∃ N, ∀ n, N ≤ n → F ⊆ sample enumeration n := by
  have hP' : GenLimit.Generic.Presents enumeration K := hP
  obtain ⟨N, hN⟩ :=
    GenLimit.Support.finite_eventually_subset_sample hP' F hF
  refine ⟨N, ?_⟩
  intro n hn u hu
  simpa [GenLimit.Generic.sample, GenLimit.sample] using hN n hn hu

/-- Presentation prefixes form a countable local basis. -/
theorem presentation_is_localBasis
    {X : Set Language} {K : Point X}
    {enumeration : ℕ → ℕ} (hP : Presents enumeration K.1) :
    ∀ O : Set (Point X), KWOpen X O → K ∈ O →
      ∃ n, basicNeighborhood X K (sample enumeration n) ⊆ O := by
  intro O hO hKO
  obtain ⟨F, hFK, hFO⟩ := hO K hKO
  obtain ⟨n, hn⟩ := finite_eventually_subset_sample hP F hFK
  refine ⟨n, ?_⟩
  intro L hL
  exact hFO ⟨fun u hu => hL.1 (hn n le_rfl hu), hL.2⟩

/-- Stage n fixes u when u is permanent from n onward and absent from the
previous stage (unless n is zero). -/
def FixesAt (tower : ℕ → Language) (n u : ℕ) : Prop :=
  (∀ m, n ≤ m → u ∈ tower m) ∧
    (n = 0 ∨ u ∉ tower (n - 1))

/-- Literal nonredundant infinite perfect tower. -/
structure PerfectTower
    (X : Set Language) (tower : ℕ → Point X) (terminal : Point X) : Prop where
  proper : ∀ n, (tower n).1 ⊂ terminal.1
  stage_fixes : ∀ n, ∃ u ∈ terminal.1,
    FixesAt (fun m => (tower m).1) n u
  complete : ∀ u ∈ terminal.1, ∃ n,
    FixesAt (fun m => (tower m).1) n u

/-- Proper sublanguages converging to the terminal language. -/
structure ConvergentProperTower
    (X : Set Language) (tower : ℕ → Point X) (terminal : Point X) : Prop where
  proper : ∀ n, (tower n).1 ⊂ terminal.1
  eventually_contains : ∀ u ∈ terminal.1, ∃ N, ∀ n, N ≤ n → u ∈ (tower n).1

theorem PerfectTower.toConvergentProperTower
    {X : Set Language} {tower : ℕ → Point X} {terminal : Point X}
    (h : PerfectTower X tower terminal) :
    ConvergentProperTower X tower terminal := by
  exact ⟨h.proper, fun u hu => by
    obtain ⟨N, hfix⟩ := h.complete u hu
    exact ⟨N, hfix.1⟩⟩

theorem finite_eventually_contained
    {X : Set Language} {tower : ℕ → Point X} {terminal : Point X}
    (h : ConvergentProperTower X tower terminal)
    (F : Finset ℕ) (hF : (↑F : Set ℕ) ⊆ terminal.1) :
    ∃ N, ∀ n, N ≤ n → (↑F : Set ℕ) ⊆ (tower n).1 := by
  classical
  induction F using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | @insert u F huF ih =>
      have huK : u ∈ terminal.1 := hF (by simp)
      have hFK : (↑F : Set ℕ) ⊆ terminal.1 := by
        intro v hv
        exact hF (by simp [hv])
      obtain ⟨Nu, hNu⟩ := h.eventually_contains u huK
      obtain ⟨NF, hNF⟩ := ih hFK
      refine ⟨max Nu NF, ?_⟩
      intro n hn v hv
      simp only [Finset.mem_coe, Finset.mem_insert] at hv
      rcases hv with rfl | hv
      · exact hNu n (le_trans (Nat.le_max_left _ _) hn)
      · exact hNF n (le_trans (Nat.le_max_right _ _) hn) hv

theorem basisLimitPoint_of_convergentProperTower
    {X : Set Language} {tower : ℕ → Point X} {terminal : Point X}
    (h : ConvergentProperTower X tower terminal) :
    BasisLimitPoint terminal := by
  intro F hF
  obtain ⟨N, hN⟩ := finite_eventually_contained h F hF
  refine ⟨tower N, ?_, ?_⟩
  · intro heq
    exact (h.proper N).ne (congrArg Subtype.val heq)
  · exact ⟨hN N le_rfl, (h.proper N).le⟩

/-- Easy direction of Paper #07 Claim 6.1 and Paper #23 Claim 3.6. -/
theorem limitPoint_of_perfectTower
    {X : Set Language} {tower : ℕ → Point X} {terminal : Point X}
    (h : PerfectTower X tower terminal) :
    IsLimitPoint terminal :=
  basisLimitPoint_iff_isLimitPoint.mp
    (basisLimitPoint_of_convergentProperTower h.toConvergentProperTower)

end GenLimit.KleinbergWei.TowerTopology
