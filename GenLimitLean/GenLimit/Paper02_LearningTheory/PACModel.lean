import GenLimit.Paper02_LearningTheory.Prediction
import GenLimit.Support.DiscreteIID
import Mathlib.Probability.Distributions.Uniform

/-! # Realizable distribution-free binary PAC learning, Definition 2.8 -/

namespace GenLimit.LiRamanTewari

open GenLimit.DiscreteIID

abbrev PACPredictor (α : Type*) := List (α × Bool) → α → Bool

noncomputable def languageLabel (K : Set α) (x : α) : Bool := by
  classical
  exact decide (x ∈ K)

def labeledSample (h : α → Bool) (xs : List α) := xs.map (fun x => (x,h x))

noncomputable def predictionRisk (p : PMF α) (f h : α → Bool) : ℝ :=
  probability p {x | f x ≠ h x}

/-- One learner and a distribution-independent sample size for every
accuracy and confidence level. Labels are generated by the fixed target. -/
def PACLearnable (H : Generic.LanguageClass α) : Prop :=
  ∃ A : PACPredictor α, ∀ ε : ℝ, 0 < ε → ε < 1 → ∀ δ : ℝ, 0 < δ → δ < 1 →
    ∃ N : ℕ, ∀ n ≥ N, ∀ (p : PMF α) (K : Set α), K ∈ H →
      probability (samples p n) {xs | ε < predictionRisk p (A (labeledSample (languageLabel K) xs))
        (languageLabel K)} ≤ δ

theorem probability_map_preimage (p : PMF α) (f : α → β) (E : Set β) :
    probability (p.map f) E = probability p (f ⁻¹' E) := by
  exact congrArg ENNReal.toReal (PMF.toOuterMeasure_map_apply _ _ _)

end GenLimit.LiRamanTewari
