import GenLimit.Paper21_GenerationInMetricSpaces.Definitions
import Mathlib.Tactic.NormNum

/-!
# Diagnostic for the equivalent-metric argument

The proof of Theorem 4.4 in arXiv:2602.07710v1 asserts that topologically
equivalent metrics have the same finite-cover status at a fixed radius.
That implication is false: topology controls sufficiently small local
balls, not the numerical value of one fixed radius.

The following concrete pair on `ℕ` gives the smallest formal diagnostic.
Both kernels induce the discrete topology, but the whole space has a
one-point cover at radius one for `unitDistance`, while it has no finite
radius-one cover for `twoDistance`.
-/

namespace GenLimit.MetricSpaces

/-- Open sets generated by an explicit distance kernel. -/
def IsKernelOpen (ρ : Distance α) (U : Set α) : Prop :=
  ∀ x ∈ U, ∃ r : ℝ, 0 < r ∧
    ∀ y, ρ x y < r → y ∈ U

/-- Equality of the two ball-generated topologies. -/
def TopologicallyEquivalentKernels
    (ρ₁ ρ₂ : Distance α) : Prop :=
  ∀ U : Set α, IsKernelOpen ρ₁ U ↔ IsKernelOpen ρ₂ U

/-- The ordinary `{0,1}` discrete distance. -/
def unitDistance : Distance ℕ :=
  fun x y ↦ if x = y then 0 else 1

/-- The rescaled `{0,2}` discrete distance. -/
def twoDistance : Distance ℕ :=
  fun x y ↦ if x = y then 0 else 2

theorem every_set_kernelOpen_unit (U : Set ℕ) :
    IsKernelOpen unitDistance U := by
  intro x hx
  refine ⟨(1 : ℝ) / 2, by norm_num, ?_⟩
  intro y hxy
  have hyx : y = x := by
    by_contra hne
    have hxy' : x ≠ y := Ne.symm hne
    simp [unitDistance, hxy'] at hxy
    norm_num at hxy
  simpa [hyx] using hx

theorem every_set_kernelOpen_two (U : Set ℕ) :
    IsKernelOpen twoDistance U := by
  intro x hx
  refine ⟨1, by norm_num, ?_⟩
  intro y hxy
  have hyx : y = x := by
    by_contra hne
    have hxy' : x ≠ y := Ne.symm hne
    simp [twoDistance, hxy'] at hxy
  simpa [hyx] using hx

theorem unit_two_topologicallyEquivalent :
    TopologicallyEquivalentKernels unitDistance twoDistance := by
  intro U
  exact ⟨fun _ ↦ every_set_kernelOpen_two U,
    fun _ ↦ every_set_kernelOpen_unit U⟩

theorem unitDistance_univ_has_radius_one_cover :
    HasFiniteCover unitDistance 1 (Set.univ : Set ℕ) := by
  refine ⟨{0}, ?_⟩
  intro y _
  have hcoe : ((↑({0} : Finset ℕ) : Set ℕ)) = {0} := by
    ext z
    simp
  rw [hcoe, mem_closedNeighborhood_singleton_iff]
  simp only [unitDistance]
  split <;> norm_num

theorem twoDistance_univ_has_no_radius_one_cover :
    ¬ HasFiniteCover twoDistance 1 (Set.univ : Set ℕ) := by
  rintro ⟨centers, hcover⟩
  obtain ⟨n, _, hn⟩ :=
    Set.infinite_univ.exists_notMem_finset centers
  have hnear :
      n ∈ closedNeighborhood twoDistance (centers : Set ℕ) 1 :=
    hcover (Set.mem_univ n)
  obtain ⟨x, hxcenters, hdist⟩ :=
    hnear ((3 : ℝ) / 2) (by norm_num)
  have hxn : x ≠ n := by
    intro h
    subst x
    exact hn hxcenters
  simp [twoDistance, hxn] at hdist
  norm_num at hdist

/-- Formal counterexample to the fixed-radius covering-number inference in
the printed proof of Theorem 4.4. -/
theorem theorem_4_4_fixed_radius_inference_false :
    TopologicallyEquivalentKernels unitDistance twoDistance ∧
      HasFiniteCover unitDistance 1 (Set.univ : Set ℕ) ∧
      ¬ HasFiniteCover twoDistance 1 (Set.univ : Set ℕ) :=
  ⟨unit_two_topologicallyEquivalent,
    unitDistance_univ_has_radius_one_cover,
    twoDistance_univ_has_no_radius_one_cover⟩

end GenLimit.MetricSpaces
